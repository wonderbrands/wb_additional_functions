<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="action_picking_report" model="ir.actions.report">
            <field name="name">Formato universal OPS</field>
            <field name="model">stock.picking</field>
            <field name="report_type">qweb-pdf</field>
            <field name="report_name">wb_picking_label.report_picking__no_batch_template</field>
            <field name="report_file">wb_picking_label.report_picking__no_batch_template</field>
            <field name="binding_model_id" ref="model_stock_picking"/>
            <field name="binding_type">report</field>
        </record>

        <template id="report_picking__no_batch_template">
            <t t-call="web.html_container">
                <t t-foreach="docs" t-as="picking">
                    <t t-call="web.external_layout">

                        <t t-set="sale_order_data" t-value="picking.get_sale_order_data()"/>
                        <div class="page">
                            <div t-if="picking.user_id"><strong>Responsable:</strong> <span t-field="picking.user_id"/></div><br/>

                            <t t-foreach="sale_order_data.values()" t-as="sale">
                                <div style="display: flex; flex-direction: row; justify-content: center; align-items: center; width: 100%; background-color: #d9e5c5; padding: 5px;">
                                    <div style="display: flex; flex-direction: column; justify-content: center; align-items: start; width: 14.2%;">
                                        <p>Orden de venta: <span><t t-esc="sale['Sale_ID']"/></span></p>
                                        <p>Marketplace: <span><t t-esc="sale['Marketplace']"/></span></p>
                                        <p>MP Order: <span><t t-esc="sale['MPOrder']"/></span></p>
                                    </div>

                                    <div style="display: flex; flex-direction: column; justify-content: center; align-items: center; width: 28.4%;">
                                        <img align="center" 
                                             t-att-src="'/report/barcode/?type=%s&amp;value=%s&amp;width=%s&amp;height=%s' % ('Code128', sale['Sale_ID'], 600, 100)" 
                                             style="width: 250px; height: 50px;" 
                                             alt="Barcode"/>
                                    </div>

                                    <div style="display: flex; flex-direction: column; justify-content: center; align-items: start; width: 14.2%;">
                                        <p><span><t t-esc="sale['Pick']"/></span></p>
                                        <p><span><t t-esc="sale['ValPick']"/></span></p>
                                        <p><span><t t-esc="sale['Out']"/></span></p>
                                    </div>

                                    <div style="display: flex; flex-direction: column; justify-content: center; align-items: center; width: 28.4%;">
                                        <img align="center" 
                                             t-att-src="'/report/barcode/?type=%s&amp;value=%s&amp;width=%s&amp;height=%s' % ('Code128', sale['Pick'], 600, 100)" 
                                             style="width: 250px; height: 50px;" 
                                             alt="Barcode"/>
                                    </div>
                                    
                                    <div style="display: flex; flex-direction: column; justify-content: center; align-items: start; width: 14.2%;">
                                        <p>Carrier: <span><t t-esc="sale['Carrier']"/></span></p>
                                        <p>Total de Guias: <span><t t-esc="sale['Guide_nums']"/></span></p>
                                        <p>Numero de Guia: <span><t t-esc="sale['Guides']"/></span></p>
                                    </div>
                                </div>

                                <!-- Product Table Header -->
                                <table class="table table-condensed" style="width: 100%; margin-top: 10px;">
                                    <thead>
                                        <tr style="background-color: #d9e5c5;">
                                            <th>SKU</th>
                                            <th>Producto</th>
                                            <th>Piezas</th>
                                            <th>Zona pickeo</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <t t-foreach="sale['Productos']" t-as="product">
                                            <tr>
                                                <td><t t-esc="product['SKU']"/></td>
                                                <td><t t-esc="product['Producto']"/></td>
                                                <td><t t-esc="product['Cantidad']"/></td>
                                                <td><t t-esc="product['Picking_zone']"/></td>
                                            </tr>
                                        </t>
                                    </tbody>
                                </table>
                            </t>
                        </div>
                    </t>
                </t>
            </t>
        </template>
    </data>
</odoo>
