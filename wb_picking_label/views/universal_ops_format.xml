<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="action_batch_picking_report" model="ir.actions.report">
            <field name="name">Formato universal OPS</field>
            <field name="model">stock.picking.batch</field>
            <field name="report_type">qweb-pdf</field>
            <field name="report_name">wb_picking_label.report_batch_picking_template</field>
            <field name="report_file">wb_picking_label_batch_picking_template</field>
            <field name="binding_model_id" ref="model_stock_picking"/>
            <field name="binding_type">report</field>
        </record>

        <template id="report_batch_picking_template">
            <t t-call="web.html_container">
                <t t-foreach="docs" t-as="o">
                    <t t-call="web.external_layout">
                        <div class="page">
                        <strong>Responsable:</strong><span t-field="o.user_id"/>
                        <div t-if="o.user_id"><strong>Responsable:</strong><span t-field="o.user_id"/></div><br/>
                        <table>
                            <tr t-foreach="o.move_line_ids" t-as="line">
                            <span t-field="line.picking_id.name" /> 
                            </tr>
                        </table>

                        <t t-foreach="pick_by_sale_orders" t-as="order">
                            <h2 t-text="order.Sale_ID"/>
                            <p>Marketplace: <t t-text="order.Marketplace"/></p>
                            <p>Carrier: <t t-text="order.Carrier"/></p>
                            <p>Carrier Ref: <t t-text="order.Carrier_ref"/></p>
                            <table>
                                <thead>
                                    <tr>
                                        <th>Product</th>
                                        <th>Quantity</th>
                                        <th>Picking Zone</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <t t-foreach="order.Productos" t-as="product">
                                        <tr>
                                            <td t-text="product.Producto"/>
                                            <td t-text="product.Cantidad"/>
                                            <td t-text="product.Picking_zone"/>
                                        </tr>
                                    </t>
                                </tbody>
                            </table>
                        </t>
                        </div>
                    </t>
                </t>
            </t>
        </template>
    </data>
</odoo>
