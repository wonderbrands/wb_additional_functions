<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="action_batch_picking_report" model="ir.actions.report">
            <field name="name">Formato universal OPS</field>
            <field name="model">stock.picking</field>
            <field name="report_type">qweb-pdf</field>
            <field name="report_name">wb_picking_label.report_batch_picking_template</field>
            <field name="report_file">wb_picking_label_batch_picking_template</field>
            <field name="binding_model_id" ref="model_stock_picking"/>
            <field name="binding_type">report</field>
        </record>

        <template id="report_batch_picking_template">
            <t t-call="web.html_container">
                <t t-foreach="docs" t-as="o">
                    <t t-call="web.external_layout">
                        <div class="page">
                        <strong>Responsable:</strong><span t-field="o.user_id"/>
                        <div t-if="o.user_id"><strong>Responsable:</strong><span t-field="o.user_id"/></div><br/>
                        <table>
                            <tr t-foreach="o.move_line_ids" t-as="line">
                            <span t-field="line.picking_id.name" /> 
                            </tr>
                        </table>

                        <t t-foreach="pick_by_sale_orders.items()" t-as="sale_name, sale_data">
                            <p>Sale Order: <t t-esc="sale_data['Sale_ID']"/></p>
                            <p>Marketplace: <t t-esc="sale_data['Marketplace']"/></p>
                            <p>Carrier: <t t-esc="sale_data['Carrier']"/></p>
                            <p>Carrier Reference: <t t-esc="sale_data['Carrier_ref']"/></p>

                            <t t-foreach="sale_data['Productos']" t-as="product">
                                <p>Producto: <t t-esc="product['Producto']"/></p>
                                <p>Cantidad: <t t-esc="product['Cantidad']"/></p>
                                <p>Picking Zone: <t t-esc="product['Picking_zone']"/></p>
                            </t>
                        </t>
                        </div>
                    </t>
                </t>
            </t>
        </template>
    </data>
</odoo>
