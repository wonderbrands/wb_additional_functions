<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="action_batch_picking_report" model="ir.actions.report">
            <field name="name">Formato universal OPS</field>
            <field name="model">stock.picking.batch</field>
            <field name="report_type">qweb-pdf</field>
            <field name="report_name">wb_picking_label.report_batch_picking_template</field>
            <field name="report_file">wb_picking_label_batch_picking_template</field>
            <field name="binding_model_id" ref="model_stock_picking_batch"/>
            <field name="binding_type">report</field>
        </record>

        <template id="report_batch_picking_template">
            <t t-call="web.html_container">
                <t t-foreach="docs" t-as="batch">
                    <t t-set="sale_order_data" t-value="batch.get_sale_order_data()"/>

                    <div class="page">
                        <h2>Picking Batch: <t t-esc="batch.name"/></h2>

                        <table class="table table-condensed">
                            <thead>
                                <tr>
                                    <th>Sale Order ID</th>
                                    <th>Marketplace</th>
                                    <th>Carrier</th>
                                    <th>Carrier Reference</th>
                                    <th>Products</th>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-foreach="sale_order_data.values()" t-as="sale">
                                    <tr>
                                        <td t-esc="sale['Sale_ID']"/>
                                        <td t-esc="sale['Marketplace']"/>
                                        <td t-esc="sale['Carrier']"/>
                                        <td t-esc="sale['Carrier_ref']"/>
                                        <td>
                                            <ul>
                                                <t t-foreach="sale['Productos']" t-as="product">
                                                    <li>
                                                        <strong>Product:</strong> <t t-esc="product['Producto']"/>
                                                        <br/>
                                                        <strong>Quantity:</strong> <t t-esc="product['Cantidad']"/>
                                                        <br/>
                                                        <strong>Picking Zone:</strong> <t t-esc="product['Picking_zone']"/>
                                                    </li>
                                                </t>
                                            </ul>
                                        </td>
                                    </tr>
                                </t>
                            </tbody>
                        </table>
                    </div>
                </t>
            </t>
        </template>
    </data>
</odoo>
