<?xml version="1.0" encoding="UTF-8" ?>

<templates xml:space="preserve">
    <t t-name="wb_outs.GuideScannerTemplate" owl="1">
        <div class="scanner-container" t-on-click="focus_input">
            <div class="guide-scanner">
                <div class="logo">
                    <img src="https://emprendedoresnews.com/wp-content/uploads/2021/03/1-scaled-e1614783938513.jpg.webp"></img>
                </div>
                <div class="presentation">
                    <h1>Escaneo de Guías de envío</h1>
                    <h3>Escanea la SO que esta pegada en el paquete</h3>
                    <div class="input_barcode">
                        <input t-ref="barcode" t-on-input="_readBarcode" type="text"/>
                    </div>
                </div>
            </div>
            <div class="scanned_log">
                <div class="title_log">
                    <h4>
                        Últimos escaneos exitosos
                    </h4>
                </div>
                <t t-foreach="state.log.logs" t-as="log">
                    <div class="succ_log">
                        <p>SO: <t t-esc="log.code"></t></p>
                        <p><t t-esc="log.timestamp"></t></p>
                    </div>
                </t>
            </div>
        </div>
        <div class="loading_screen" t-if="state.app_state.showModal()">
            <div class="mod waiting" t-if="state.app_state.isAppWaiting()">
                <div class="loader"></div>
                <h3>
                    Esperando respuesta del servidor
                </h3>
            </div>
            <div class="mod error-message" t-if="state.app_state.isAppDisplayingMessage() and state.response.isError()">
                <div>
                    <svg width="250px" height="250px" viewBox="0 0 1024 1024" ><path fill="#FFFFFF" d="M512 64a448 448 0 1 1 0 896 448 448 0 0 1 0-896zm0 192a58.432 58.432 0 0 0-58.24 63.744l23.36 256.384a35.072 35.072 0 0 0 69.76 0l23.296-256.384A58.432 58.432 0 0 0 512 256zm0 512a51.2 51.2 0 1 0 0-102.4 51.2 51.2 0 0 0 0 102.4z"/></svg>
                </div>
                <h3>
                    <t t-esc="state.response.message"/>
                </h3>
            </div>
            <div class="mod ok-message" t-if="state.app_state.isAppDisplayingMessage() and state.response.isSuccess()">
                <div> 
                    <svg width="250px" height="250px" viewBox="0 0 24 24" fill="none"><path fill="white" fill-rule="evenodd" clip-rule="evenodd" d="M22 12C22 17.5228 17.5228 22 12 22C6.47715 22 2 17.5228 2 12C2 6.47715 6.47715 2 12 2C17.5228 2 22 6.47715 22 12ZM16.0303 8.96967C16.3232 9.26256 16.3232 9.73744 16.0303 10.0303L11.0303 15.0303C10.7374 15.3232 10.2626 15.3232 9.96967 15.0303L7.96967 13.0303C7.67678 12.7374 7.67678 12.2626 7.96967 11.9697C8.26256 11.6768 8.73744 11.6768 9.03033 11.9697L10.5 13.4393L12.7348 11.2045L14.9697 8.96967C15.2626 8.67678 15.7374 8.67678 16.0303 8.96967Z"/></svg>
                </div>
                <h3>
                    <t t-esc="state.response.message"/>
                </h3>
            </div>
        </div>
    </t>
</templates>
