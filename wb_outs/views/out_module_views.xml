<odoo>
    <data>
        <record id="view_master_shipping_guides_tree" model="ir.ui.view">
            <field name="name">wb.outs.master.shipping.guides.tree</field>
            <field name="model">wb_outs.master_shipping_guides</field>
            <field name="arch" type="xml">
                <tree string="Master Shipping Guides">
                    <field name="name"/>
                    <!-- Add other fields to display here -->
                </tree>
            </field>
        </record>

        <record id="view_master_shipping_guides_form" model="ir.ui.view">
            <field name="name">wb.outs.master.shipping.guides.form</field>
            <field name="model">wb_outs.master_shipping_guides</field>
            <field name="arch" type="xml">
                <form string="Master Shipping Guide">
                    <group>
                        <h1>
                            <field name="name"/>
                        </h1>
                        <div>
                            <field name="scanned" />
                            <field name="scanned_timestamp" />
                            <field name="scanned_by" />
                        </div>
                        <div>
                            <field name="sale_id" />
                        </div>
                        <div>
                            <field name="products_ids" />
                        </div>
                        <div>
                            <field name="possible_scannable_codes" />
                        </div>
                        <notebook>
                            <page string="More Info">
                                <field name="carrier"/>
                                <field name="stock_movs"/>
                            </page>
                        </notebook>
                    </group>
                </form>
            </field>
        </record>

    </data>
</odoo>
