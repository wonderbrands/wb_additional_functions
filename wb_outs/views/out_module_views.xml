<odoo>
    <data>    
        <record id="view_scanner_log_tree" model="ir.ui.view">
            <field name="name">wb_outs.scanner_log.tree</field>
            <field name="model">wb_outs.scanner_log</field>
            <field name="arch" type="xml">
                <tree string="Scanner Log">
                    <field name="code"/>
                    <field name="scanned_at"/>
                    <field name="scanned_by"/>
                    <field name="exists_so"/>
                    <field name="sale_order_id"/>
                    <field name="status_of_scan"/>
                    <field name="times_scanned"/>
                    <field name="closed_out"/>
                    <field name="num_of_sg"/>
                </tree>
            </field>
        </record>

        <record id="view_scanner_log_form" model="ir.ui.view">
            <field name="name">wb_outs.scanner_log.form</field>
            <field name="model">wb_outs.scanner_log</field>
            <field name="arch" type="xml">
                <form string="Scanner Log">
                    <sheet>
                        <group>
                            <field name="code"/>
                            <field name="scanned_at"/>
                        </group>
                        <group>
                            <field name="scanned_by"/>
                            <field name="exists_so"/>
                            <field name="sale_order_id"/>
                            <field name="status_of_scan"/>
                            <field name="times_scanned"/>
                            <field name="closed_out"/>
                            <field name="num_of_sg"/>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>
    </data>
</odoo>
