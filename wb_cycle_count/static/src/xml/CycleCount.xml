<?xml version="1.0" encoding="UTF-8" ?>

<templates xml:space="preserve">
    <t t-name="wb_cycle_count.CycleCountTemplate" owl="1">
        <div class="app-container" t-on-click="focus_active">
            <div class="instructions">
                <div id="root">
                </div>
                <input class="barcode-reader" t-ref="zonebarcode" t-on-input="_readZoneBarcode" type="text"/>
                <input class="barcode-reader invisible" id="productBarcode" t-ref="productbarcode" t-on-input="_readProductBarcode" type="text"/>
                <input class="invisible" id="qty" t-ref="qty" type="number" />
                <button  id="count_button" class="invisible" t-on-click="confirmQty">
                    Contar dentro del inventario
                </button>
            </div>
            <div id="info" class="visualization">
                <h1>Información</h1>
            </div>
        </div>
    </t>
</templates>
