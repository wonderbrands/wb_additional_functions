<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="waves_report_template">
        <t t-call="web.html_container">
            <t t-call="web.external_layout">
                <t t-foreach="records" t-as="record">
                    <div>
                        <img t-att-src="'/report/barcode/?type=Code128&amp;value=' + record.name + '&amp;width=530&amp;height=460&amp;humanreadable=1&amp;quiet=0'"/>
                    </div>
                </t>
            </t>
        </t>
    </template>
</odoo>