<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="wb_cycle_count_log_tree" model="ir.ui.view">
        <field name="name">wb_cycle_count.log.tree</field>
        <field name="model">wb_cycle_count.log</field>
        <field name="arch" type="xml">
            <tree decoration-info="status == 'success'" decoration-muted="status in ('no_stock_location', 'product_not_exist', 'product_already_counted')" editable="bottom" edit="1" >
                <field name="scanned" />
                <field name="scanned_by" />
                <field name="scanned_at" />
                <field name="zone" />
                <field name="product" />
                <field name="qty" />
                <field name="status" />
                <field name="session"/>
                <field name="is_an_error"/>
            </tree>
        </field>
    </record>

    <record id="wb_cycle_count_log_form" model="ir.ui.view">
        <field name="name">wb_cycle_count.log.form</field>
        <field name="model">wb_cycle_count.log</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="scanned" readonly="1"/>
                        <field name="scanned_by" readonly="1"/>
                        <field name="scanned_at" readonly="1"/>
                    </group>
                    <group>
                        <field name="zone" readonly="1"/>
                        <field name="product" readonly="1"/>
                        <field name="qty" readonly="1"/>
                    </group>
                    <group>
                        <field name="status" readonly="1"/>
                        <field name="session" readonly="1"/>
                    </group>
                    <group>
                        <field name="is_an_error" />
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    
    <record id="wb_cycle_count_session_tree" model="ir.ui.view">
        <field name="name">wb_cycle_count.session.tree</field>
        <field name="model">wb_cycle_count.count_session</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name" string="ID" />
            </tree>
        </field>
    </record>

        <record id="wb_cycle_count_session_form" model="ir.ui.view">
        <field name="name">wb_cycle_count.session.form</field>
        <field name="model">wb_cycle_count.count_session</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_title">
                        <label for="name" string="ID" class="oe_edit_only"/>
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                        <field name="barcode_url" widget="image_url" />
                    </div>
                </sheet>
            </form>
        </field>
    </record>
</odoo>
